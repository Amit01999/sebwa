# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/cloud/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sebwa?retryWrites=true&w=majority

# --- Auth ---
# Long random string used to sign admin JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# One-time admin seed (used only by `npm run seed:admin`, never read at request time)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me
ADMIN_SEED_NAME=Admin

# --- CORS ---
# Exact origin(s) of the deployed frontend, comma-separated. No trailing slash.
# e.g. https://sebwa.vercel.app,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# --- Cloudinary ---
# Create a free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
